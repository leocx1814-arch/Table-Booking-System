# Backend Service Settings
PORT=5001
NODE_ENV=development

# MySQL Service Settings (Development container name is 'db')
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_LOCAL_PORT=3307
MYSQL_DATABASE=booking_db
MYSQL_USER=booking_user
MYSQL_PASSWORD=booking_pass
MYSQL_ROOT_PASSWORD=root_pass
# Set to 'true' when using TiDB Cloud, PlanetScale, Aiven, or any cloud DB requiring TLS/SSL
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Frontend Service Settings
VITE_PORT=5173
VITE_API_URL=http://localhost:5001

# Auth Settings (Phase 4)
# Replace with a strong random secret in production (e.g. openssl rand -base64 64)
JWT_SECRET=change_this_to_a_long_random_secret_before_production
JWT_EXPIRES_IN=8h
